# Template only - no real values in here. These go into Vercel's
# Project -> Settings -> Environment Variables (or `vercel env add`), Production at least.
# Redeploy after changing any of them.

# --- Discord login ---------------------------------------------------------
# The same Discord application as the verify panel and the wiki works: only the
# `identify` scope is asked for. Add the redirect there, exactly:
#   https://<this game's domain>/api/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Session ---------------------------------------------------------------
# Signs the login cookie. 32+ characters, its own value (not the panel's).
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
SESSION_SECRET=

# Pins the OAuth redirect, so preview deployments come back to production.
PUBLIC_URL=https://uncrown.vercel.app

# --- Cloud saves (server/saves.mjs on the VPS) -----------------------------
# The save service behind the VPS's nginx, over HTTPS.
SAVES_API_URL=https://107-152-36-220.sslip.io/uncrown
# Must match SAVES_TOKEN in /etc/uncrown-saves.env on the VPS. 24+ characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SAVES_TOKEN=
